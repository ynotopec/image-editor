# Required: API token used by clients in Authorization: Bearer <token>
API_TOKEN=change-me

# Required for local mode
INFERENCE_MODE=local
MODEL_ID=Qwen/Qwen-Image-Edit-2511
# Optional alternative (LoRA multi-angles): fal/Qwen-Image-Edit-2511-Multiple-Angles-LoRA
DEVICE=cuda
DTYPE=bfloat16

# Optional/default: long side resize (pixels)
# MAX_SIDE=1280
# UNLOAD_IDLE_SECONDS=300

# Optional: endpoint mode only
# ENDPOINT_URL=https://api-inference.huggingface.co/models/dx8152/Qwen-Edit-2509-Multiple-angles
# HF_TOKEN=hf_xxx
